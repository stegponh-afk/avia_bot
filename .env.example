# Скопируй в .env и заполни:  cp .env.example .env
# Пустое значение = берётся умолчание из config.py.
# Комментарии только на отдельных строках: то, что после # в одной строке
# со значением, Compose может утащить внутрь переменной.

# ---------- обязательное ----------
# токен от @BotFather
AVIA_BOT_TOKEN=
# токен travelpayouts.com, без него цен не будет
TP_TOKEN=

# ---------- коридор цен, рубли ----------
AVIA_PRICE_MIN=5000
AVIA_PRICE_MAX=10000

# ---------- кто может пользоваться ботом ----------
# Пусто = кто угодно. Свой id бот покажет на /start. Несколько — через запятую.
AVIA_ADMIN_IDS=

# ---------- прокси ----------
# На сервере с прямым доступом к Telegram оставь пусто — так и надо.
# Дома за v2rayN: socks5://host.docker.internal:10808
# (и раскомментируй extra_hosts в docker-compose.yml)
AVIA_BOT_PROXY=
AVIA_API_PROXY=
AVIA_TG_PROXY=

# ---------- поиск ----------
# откуда летим
AVIA_ORIGIN=KZN
# 0 = цены туда-обратно
AVIA_ONE_WAY=1
# горизонт поиска, месяцев
AVIA_MONTHS=6
# 1 = только прямые рейсы
AVIA_DIRECT=0
# как часто опрашивать источники, минуты
AVIA_POLL_MIN=45
# больше сообщений за один проход не слать
AVIA_MAX_ALERTS=10

# ---------- чтение каналов про горящие билеты, необязательно ----------
# Перед первым запуском: docker compose run --rm bot python login.py
AVIA_TG_WATCH=0
# ключи с my.telegram.org
TG_API_ID=
TG_API_HASH=
# хэндлы каналов без @, через запятую
AVIA_TG_CHANNELS=

# ---------- партнёрский маркер travelpayouts, необязательно ----------
TP_MARKER=
